{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": [
    "src/server/**/*.ts",
    "src/game/**/*.ts",
    "src/protocol/**/*.ts"
  ],
  "exclude": [
    "src/web",
    "tests",
    "e2e"
  ]
}
